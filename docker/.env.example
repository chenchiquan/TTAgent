# ============================================================
# TTAgent 环境配置模板
# 用法：复制本文件为 docker/.env，填入真实值
#   cp docker/.env.example docker/.env
# docker/.env 不要提交 GitHub（已加 .gitignore）
# ============================================================

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=ttagent
MYSQL_USER=ttagent
MYSQL_PASSWORD=ttagent123
MYSQL_HOST=mysql        # 容器名（compose 里 environment 会覆盖，这里写容器名）
MYSQL_PORT=3306         # 容器内端口
MYSQL_DB=ttagent

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== JWT（Java 后端）=====
JWT_SECRET=ttagent-he-tao-memory-secret-key-2026-change-me-please-32bytes
JWT_EXPIRE=86400000

# ===== Java 调 Python 的地址（容器内用容器名）=====
PYTHON_CHAT_URL=http://ai-service:8000/chat

# ===== LLM（Python，DeepSeek，OpenAI 兼容）=====
LLM_API_KEY=填你的 deepseek api key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-chat
